# DhanHQ v2 — generate access token at web.dhan.co → My Profile → DhanHQ Trading APIs
# NEVER commit the real .env. Values live in .env (gitignored) or the orchestrator's secured env file.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_BASE_URL=https://api.dhan.co/v2

# Safety: live order placement is HARD-DISABLED unless this is exactly "i-approve-live-trading"
# (and even then every order requires per-action operator approval upstream).
ALGOTRADER_LIVE_ENABLE=

# Optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
